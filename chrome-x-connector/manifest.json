{
  "manifest_version": 3,
  "name": "IMAGEX · X",
  "description": "Reads X timelines in your signed-in Chrome session for the local IMAGEX app.",
  "version": "1.3.0",
  "key": "",
  "permissions": ["storage"],
  "externally_connectable": {
    "matches": ["http://127.0.0.1/*", "http://localhost/*"]
  },
  "background": { "service_worker": "worker.js" },
  "content_scripts": [
    { "matches": ["https://x.com/*"], "js": ["read-x.js", "x-page.js"] }
  ]
}
