# Public Sentry project DSN (not an auth token); leave empty to disable sending.
VITE_SENTRY_DSN=

# Public GitHub repository slug (owner/repo); defaults to profilehub-app/imagex if empty.
VITE_GITHUB_REPO=

# Public https:// links for Community & Support (never put tokens or secrets in VITE_* variables).
VITE_PROMO_SITE_URL=
VITE_COMMUNITY_URL=
VITE_DONATE_URL=
VITE_DONATE_SECONDARY_URL=
